eda_help() {
    # ANSI colors
    local RESET=$'\e[0m'
    local BOLD=$'\e[1m'
    local DIM=$'\e[2m'
    local GREEN=$'\e[32m'
    local BRIGHT_GREEN=$'\e[92m'
    local GRAY=$'\e[90m'

    clear

    # Smooth line-printing effect
    _println() {
        printf "%s\n" "$1"
        sleep 0.12   # <-- nice speed: not too slow, not instant
    }

    printf "${GREEN}"

    _println '###############################################'
    _println '#                                             #'

    printf '#      '
    printf "%sEDA CONSOLE – FUNCTION MAP%s" "${BRIGHT_GREEN}${BOLD}" "${RESET}${GREEN}"
    _println '             #'

    _println '#                                             #'
    _println '###############################################'
    printf "${RESET}\n"

    # Slight pause before sections
    sleep 0.1

    # Section printer
    _sec() {
        printf "${BRIGHT_GREEN}${BOLD}▶ %s${RESET}\n" "$1"
        printf "  ${DIM}%s${RESET}\n" "$2"
        sleep 0.05
    }

    # Usage printer
    _usage() {
        printf "  ${GREEN}Usage:${RESET}  %s\n\n" "$1"
        sleep 0.03
    }

    ###############################
    #       Function Entries      #
    ###############################

    _sec "RUNT" "Run your main RTL/sim/synth Tcl flow driver."
    _usage "RUNT [args...]
         e.g. RUNT -t=my_top.sv -tb=<testbench.sv> -f my_top"

    _sec "update_eda" "Update/build your EDA tools (yosys, magic, ngspice, etc.)."
    _usage "update_eda [tool | options...]
         e.g. update_eda yosys
              update_eda -y"

    _sec "edaclean" "Clean logs/build/output dirs in your EDA environment."
    _usage "edaclean"

    _sec "spicesym" "Generate xschem .sch or .sym from a SPICE netlist."
    _usage "spicesym <file.spice>
         e.g. spicesym counter.spice > counter.sch"

    _sec "openlane_run" "Activate OL2 venv + run OpenLane2 in Docker."
    _usage "openlane_run <path/to/config.json>
         e.g. openlane_run designs/counter_4bit/config.json"

    _sec "mk_openlane_design" "Create an OpenLane2 project skeleton with config + RTL."
    _usage "mk_openlane_design -d <dir> [-f <rtl_basename>]
         e.g. mk_openlane_design -d counter_4bit
              mk_openlane_design -d alu8 -f alu_core"

    printf "${GRAY}${DIM}Tip: type ${GREEN}functions${GRAY} to see all defined shell functions.${RESET}\n\n"
}




