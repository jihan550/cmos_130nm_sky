# Enable Environment Modules in zsh
if [ -f /usr/share/modules/init/zsh ]; then
    source /usr/share/modules/init/zsh
elif [ -f /etc/profile.d/modules.sh ]; then
    source /etc/profile.d/modules.sh
fi

# Make sure our personal module tree is on MODULEPATH _after_ init
if command -v module >/dev/null 2>&1; then
  module use -a "$HOME/modules/eda"

  # Prefer our magic module over any system one
  module unload magic 2>/dev/null

  module load xschem/default
  module load magic/default
  module load yosys/default
  module load iverilog/default
fi


#===================================================#

# ================== SYNC STALE MODULEFILES ================== #
sync_eda_modules() {
  for tool in magic yosys iverilog xschem ngspice; do
    local moddir="$HOME/modules/eda/$tool"
    local instroot="$HOME/eda/${tool}-installs"

    [[ -d "$moddir" ]] || continue

    for mf in "$moddir"/*; do
      local base="${mf##*/}"

      # Keep the "default" symlink/file
      [[ "$base" == "default" ]] && continue

      local instdir="$instroot/$base"
      if [[ ! -d "$instdir" ]]; then
        echo "[module-clean] Removing stale modulefile: $mf (no install $instdir)"
        rm -f -- "$mf"
      fi
    done
  done
}

# Run this once at startup
sync_eda_modules
# ================== END MODULE SYNC ================== #


