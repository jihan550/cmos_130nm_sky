# ================== GIT STATUS CHECK =================== #

# Just definitions here: no output during init.
check_git_folder() {
    local repo="$1"
    [ ! -d "$repo/.git" ] && return

    local changes
    changes=$(git -C "$repo" status --short)
    
    print -P "%F{cyan}[$repo] git fetch:%f"
    changes=$(git -C "$repo" fetch)

    print -P "%F{cyan}[$repo] git status:%f"


    if [[ -z "$changes" ]]; then
        echo "  (clean)"
    else
        echo "$changes"
    fi
    echo
}


eda_git_status_on_first_prompt() {
    # Run only once per shell session
    if [[ -n "${__EDA_GIT_STATUS_SHOWN-}" ]]; then
        return
    fi
    __EDA_GIT_STATUS_SHOWN=1

    # Call for each repo you care about
    check_git_folder "$HOME/eda/yosys"
    check_git_folder "$HOME/eda/xschem-src"
    check_git_folder "$HOME/eda/ngspice_git"
    check_git_folder "$HOME/eda/magic"
    check_git_folder "$HOME/eda/iverilog"
    check_git_folder "$HOME/eda/openlane2"
    check_git_folder "$HOME/eda/open_pdks"
}

# Hook our function to run before the first prompt (after init completes)
autoload -Uz add-zsh-hook
add-zsh-hook precmd eda_git_status_on_first_prompt

# ================== GIT STATUS CHECK END ================== #



