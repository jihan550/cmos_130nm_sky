# ================== EDA AUTO-SETUP ================== #
# Base EDA root
export EDA_ROOT="$HOME/eda"
export OPEN_PDKS="$EDA_ROOT/open_pdks"

# Auto-detect Sky130 PDK variant and set PDK_ROOT + PDK
setup_pdk_env() {
  # Prefer sky130A, fall back to sky130B if needed
  local skyroot="$OPEN_PDKS/sky130"

  if [[ -d "$skyroot/sky130A/libs.tech/xschem" ]]; then
    export PDK_ROOT="$skyroot"      # directory that CONTAINS sky130A
    export PDK="sky130A"
  elif [[ -d "$skyroot/sky130B/libs.tech/xschem" ]]; then
    export PDK_ROOT="$skyroot"
    export PDK="sky130B"
  else
    echo "[EDA] WARNING: No sky130A/sky130B with libs.tech/xschem found under $skyroot" >&2
  fi

  # Optionally set useful liberty file paths if sky130A exists
  if [[ -d "$skyroot/sky130A/libs.ref/sky130_fd_sc_hd/lib" ]]; then
    export SKY130_HD_TT="$skyroot/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib"
    export SKY130_HD_FF="$skyroot/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ff_100C_1v95.lib"
    export SKY130_HD_SS="$skyroot/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ss_n40C_1v60.lib"
  fi
}

# EDA tools locations (if you keep sources under ~/eda)
setup_eda_tools() {
  export XSCHEM_TOP="$EDA_ROOT/xschem-src"
  export MAGIC_TOP="$EDA_ROOT/magic"
  export ICARUS_TOP="$EDA_ROOT/iverilog"
  export YOSYS_TOP="$EDA_ROOT/yosys"
  export OPENLANE="$EDA_ROOT/openlane2"
  export NGSPICE_TOP="$EDA_ROOT/ngspice_git"

  # Optional: prepend their typical bin locations to PATH if they exist
  for d in \
    "$XSCHEM_TOP" \
    "$MAGIC_TOP" \
    "$YOSYS_TOP" \
    "$ICARUS_TOP" \
    "$NGSPICE_TOP"; do
    [[ -d "$d" ]] && PATH="$d:$PATH"
  done
}

# Quick environment checker
eda_env() {
  local green="\033[0;32m"
  local red="\033[0;31m"
  local yellow="\033[0;33m"
  local cyan="\033[0;96m"
  local reset="\033[0m"

  printf "${cyan}=== EDA ENV ===${reset}\n"

  # Vars that correspond to actual paths
  for v in EDA_ROOT OPEN_PDKS PDK_ROOT \
           XSCHEM_TOP MAGIC_TOP YOSYS_TOP ICARUS_TOP NGSPICE_TOP OPENLANE \
           SKY130_HD_TT SKY130_HD_FF SKY130_HD_SS; do

    eval val="\${$v}"

    if [[ -z "$val" ]]; then
      printf "%-16s = ${yellow}(not set)${reset}\n" "$v"
    else
      if [[ -d "$val" || -f "$val" ]]; then
        printf "%-16s = %s  ${green}[OK]${reset}\n" "$v" "$val"
      else
        printf "%-16s = %s  ${red}[MISSING]${reset}\n" "$v" "$val"
      fi
    fi
  done

  # PDK is symbolic, not a path → no [OK]/[MISSING]
  if [[ -z "$PDK" ]]; then
    printf "%-16s = ${yellow}(not set)${reset}\n" "PDK"
  else
    printf "%-16s = ${green}%s${reset}\n" "PDK" "$PDK"
  fi

  printf "${cyan}================${reset}\n"
}


# Call auto-setup when shell starts
setup_pdk_env
setup_eda_tools
# ================== EDA AUTO-SETUP END ================== #



