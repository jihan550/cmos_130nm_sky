# --- OpenLane2 helper function ---
openlane_run() {
    # 1. Path to your OpenLane2 virtualenv
    local venv="$HOME/eda/openlane2/.venv"

    # 2. Activate the venv
    if [ -d "$venv" ]; then
        source "$venv/bin/activate"
    else
        echo "❌ OpenLane2 venv not found at $venv"
        return 1
    fi

    # 3. Require one argument: path to config.json
    if [ $# -eq 0 ]; then
        echo "Usage: openlane_run <path/to/config.json>"
        deactivate
        return 1
    fi

    local cfg="$1"

    if [ ! -f "$cfg" ]; then
        echo "❌ Config file not found: $cfg"
        return 1
    fi

    # 4. Run OpenLane2 in dockerized mode
    echo "🚀 Running OpenLane2 with config: $cfg"
    openlane --dockerized "$cfg"

    # 5. Deactivate the venv automatically afterwards
    deactivate
}


# --- Create OpenLane2 project template ---
mk_openlane_design() {
    local dir=""
    local rtlname=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--dir)
                dir="$2"
                shift 2
                ;;
            -f|--file)
                rtlname="$2"
                shift 2
                ;;
            *)
                echo "❌ Unknown option: $1"
                echo "Usage: mk_openlane_design -d <dir> [-f <rtl_file_basename>]"
                return 1
                ;;
        esac
    done

    # Required: directory
    if [[ -z "$dir" ]]; then
        echo "❌ Missing required -d <dir>"
        echo "Usage: mk_openlane_design -d <dir> [-f <rtl_file_basename>]"
        return 1
    fi

    # If RTL name not given → default to directory name
    if [[ -z "$rtlname" ]]; then
        rtlname="$dir"
    fi

    # Create directory structure
    mkdir -p "$dir/src"

    # Create skeleton RTL if not exists
    rtlpath="$dir/src/${rtlname}.v"
    if [[ ! -f "$rtlpath" ]]; then
        cat > "$rtlpath" <<EOF
module ${rtlname} (
    input  clk,
    input  rst_n,
    output reg [3:0] count
);
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            count <= 4'd0;
        else
            count <= count + 1'b1;
    end
endmodule
EOF
        echo "📄 Created RTL: $rtlpath"
    else
        echo "⚠️ RTL already exists: $rtlpath"
    fi

    # Create config.json
    cfg="$dir/config.json"
    cat > "$cfg" <<EOF
{
  "DESIGN_NAME": "${rtlname}",
  "VERILOG_FILES": [
    "dir::src/${rtlname}.v"
  ],
  "CLOCK_PORT": "clk",
  "CLOCK_PERIOD": 20.0,
  "FP_SIZING": "absolute",
  "DIE_AREA": "0 0 200 200",
  "FP_CORE_UTIL": 10,
  "PDK": "sky130A",
  "STD_CELL_LIBRARY": "sky130_fd_sc_hd"
}
EOF

    echo "📄 Created config: $cfg"

    # Final message
    echo "✅ OpenLane2 design created at: $dir/"
}


