# --- Tools ---
alias ls='lsd'

# --- EDA / Work ---
alias virtuoso='xschem'

alias gozsh='code ~/.zshrc'

alias update='sudo apt update && sudo apt upgrade'

# --- Meta: list my aliases grouped by section (auto) ---
# If an alias with this name exists, remove it so we can define a function.
unalias listaliases 2>/dev/null

listaliases() {
  emulate -L zsh
  local file=${ZSH_ALIASES_FILE:-$HOME/.zsh_aliases}

  awk '
    BEGIN { section = "" }
    # Section header lines like: "# --- Section Name ---"
    /^\s*#\s*---/ {
      sec = $0
      sub(/^.*---[[:space:]]*/, "", sec)
      sub(/[[:space:]]*---.*$/, "", sec)
      section = sec
      next
    }
    # Alias lines: alias name='\''value'\''
    /^\s*alias[[:space:]]+[A-Za-z0-9_.-]+=/ {
      if (!(section in seen)) {
        printf("\n=== %s ===\n", (section == "" ? "Misc" : section))
        seen[section] = 1
      }
      match($0, /alias[[:space:]]+([^=]+)=['\''"](.+)['\''"]$/, m)
      name = m[1]; val = m[2]
      printf("%-14s → %s\n", name, val)
    }
  ' "$file" | sed "1{/^$/d;}"
}
