# --- Navigation ---
alias cdhome='cd ~/'
alias cdprojects='cd ~/projects'
alias cdunits='cd ~/projects/units/'
alias goeda='cd ~/eda'
alias gosim='cd ~/.xschem/simulations'
alias act='source /home/jihan/eda/openlane2/.venv/bin/activate'
alias goscripts='cd ~/projects/scripts/'
