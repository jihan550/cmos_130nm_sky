        RECT 4.400 30.240 30.695 31.640 ;
        RECT 3.990 28.240 31.095 30.240 ;
        RECT 4.400 26.840 30.695 28.240 ;
        RECT 3.990 24.840 31.095 26.840 ;
        RECT 4.400 23.440 30.695 24.840 ;
        RECT 3.990 21.440 31.095 23.440 ;
        RECT 4.400 20.040 30.695 21.440 ;
        RECT 3.990 18.040 31.095 20.040 ;
        RECT 4.400 16.640 30.695 18.040 ;
        RECT 3.990 14.640 31.095 16.640 ;
