digraph "counter_4bit" {
label="counter_4bit";
rankdir="LR";
remincross=true;
n4 [ shape=octagon, label="count", color="black", fontcolor="black"];
n5 [ shape=octagon, label="rst_n", color="black", fontcolor="black"];
n6 [ shape=octagon, label="clk", color="black", fontcolor="black"];
v0 [ label="1" ];
c10 [ shape=record, label="{{<p7> A|<p8> B}|$3\n$add|{<p9> Y}}",  ];
c11 [ shape=record, label="{{<p7> A}|$2\n$logic_not|{<p9> Y}}",  ];
x2 [ shape=record, style=rounded, label="<s0> 3:0 - 3:0 ", color="black", fontcolor="black" ];
p1 [shape=box, style=rounded, label="PROC $1\n/home/jihan/projects/openlane_flow/designs/counter_4bit/src/counter_4bit.v:3.5-8.8", ];
c10:p9:e -> x2:s0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c11:p9:e -> p1:w [color="black", fontcolor="black", label=""];
p1:e -> n4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c10:p7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> p1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c11:p7:w [color="black", fontcolor="black", label=""];
n5:e -> p1:w [color="black", fontcolor="black", label=""];
n6:e -> p1:w [color="black", fontcolor="black", label=""];
v0:e -> c10:p8:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x2:e -> p1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
